// ─── El lector del stream ─────────────────────────────────────────────────
// Los mensajes llegan de a poco mientras el agente trabaja. Esto los pinta.

function imprimir(mensaje: SDKMessage): void {
  // Un mensaje con parent_tool_use_id salió de adentro de un ayudante (paso 7).
  const sangria =
    "parent_tool_use_id" in mensaje && mensaje.parent_tool_use_id ? "   ↳ " : "";

  if (mensaje.type === "assistant") {
    for (const bloque of mensaje.message.content) {
      if (bloque.type === "tool_use") {
        const input = (bloque.input ?? {}) as Record<string, unknown>;
        // El argumento más informativo de cada herramienta nativa.
        const arg =
          input.command ?? input.file_path ?? input.pattern ?? input.prompt ??
          // tus funciones (paso 5) tienen argumentos propios: van completos
          Object.entries(input).map(([k, v]) => `${k}=${v}`).join(", ");
        console.log(`${sangria}🔧 ${bloque.name}(${String(arg).slice(0, 80)})`);
      } else if (bloque.type === "text" && bloque.text.trim()) {
        console.log(`${sangria}${bloque.text.trim()}`);
      }
    }
  } else if (mensaje.type === "user") {
    // Una herramienta que falla no rompe el agente: el error vuelve como contexto.
    const contenido = mensaje.message.content;
    if (Array.isArray(contenido)) {
      for (const bloque of contenido) {
        if (bloque.type === "tool_result" && bloque.is_error) {
          console.log(`   ❌ la herramienta falló: ${String(bloque.content).slice(0, 200)}`);
        }
      }
    }
  } else if (mensaje.type === "result") {
    if (mensaje.subtype === "success") {
      console.log(`\n${"─".repeat(60)}`);
    } else {
      // error_max_turns · error_max_budget_usd · error_during_execution
      console.log(`\n⚠️  terminó por: ${mensaje.subtype}`);
    }
    const costo = mensaje.total_cost_usd ?? 0;
    const segundos = (mensaje.duration_ms ?? 0) / 1000;
    console.log(`${mensaje.num_turns} turnos · $${costo.toFixed(4)} · ${segundos.toFixed(0)}s`);
  }
}

const PROMPT = "{{PROMPT_PRUEBA}}";

console.log(`▶ {{NOMBRE}}\n`);
for await (const mensaje of query({ prompt: PROMPT, options: opciones })) {
  imprimir(mensaje);
}

