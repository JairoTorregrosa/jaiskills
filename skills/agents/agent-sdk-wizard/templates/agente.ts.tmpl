import * as readline from "node:readline/promises";

const SEGURAS = new Set(["Read", "Glob", "Grep"]);
const rl = readline.createInterface({ input: process.stdin, output: process.stdout });

const aprobar: NonNullable<Options["canUseTool"]> = async (nombre, input) => {
  if (SEGURAS.has(nombre)) return { behavior: "allow", updatedInput: input };
  console.log(`\n[${nombre}]`, JSON.stringify(input, null, 2));
  const r = await rl.question("  ¿Permitir? (s/n): ");
  if (r.trim().toLowerCase() === "s") return { behavior: "allow", updatedInput: input };
  // El mensaje lo LEE el modelo: dile qué hacer distinto, no solo que no.
  return { behavior: "deny", message: "No autorizado. Propón una alternativa sin escribir en disco." };
};

// …y cierra la terminal al final del archivo:
rl.close();
