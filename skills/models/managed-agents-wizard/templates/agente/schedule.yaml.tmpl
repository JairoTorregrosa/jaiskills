name: <nombre> <cuándo>
deployment_file: deployment-<cuando>.yaml
schedule: {type: cron, expression: "0 7 * * 1-5", timezone: America/Bogota}
budget: {type: limit, max_list_cost: {amount: "500", currency: USD}}   # cents: "500" = USD 5
