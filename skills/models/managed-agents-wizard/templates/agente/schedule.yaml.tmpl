name: <nombre> <cuándo>
deployment_file: deployment-<cuando>.yaml
schedule: {type: cron, expression: "0 7 * * 1-5", timezone: America/Bogota}
budget: {type: limit, max_list_cost: {amount: "500", currency: USD}}   # cents: "500" = USD 5
vault_ids: [./vault.yaml]                # a path: ant apply creates the vault first; omit if no credentials
resources:
  - {path: ./memory_store-memoria.yaml, access: read_write}   # read_only for rules when the agent reads untrusted input
max_iterations: 2                        # outcome rounds, only used when rubric.md exists
