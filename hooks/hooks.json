{
  "description": "insistir quality gates: reviewer Bash whitelist and review-before-complete. Both no-op outside an insistir run.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/orchestration/insistir/hooks/reviewer_bash_filter.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/orchestration/insistir/hooks/task_completed.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
